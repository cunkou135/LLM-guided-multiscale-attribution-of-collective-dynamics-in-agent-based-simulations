  "nodes": [
    {
      "indicator_id": "fish_nn_distance_micro",
      "phenomenon_id": "school_fission_stretch",
      "name": "Fish nearest-neighbor distance",
      "scale": "micro",
      "description": "Per-fish Euclidean distance to the closest other fish at the same sampled step, capturing local spacing and individual isolation relevant to fission and stretching.",
      "mathematical_definition": "For each run_id r and step t, let F_{r,t} = {i : role_i = 'fish' at (r,t)}. For each i in F_{r,t} with finite coordinates (x_i(t), y_i(t)), define d_i(t) = min_{j in F_{r,t}, j != i} sqrt((x_i(t)-x_j(t))^2 + (y_i(t)-y_j(t))^2). If |F_{r,t}| < 2 or no finite-coordinate neighbor exists, d_i(t) is undefined for that i. The micro indicator is the per-fish value d_i(t).",
      "units": "model length units",
      "computation_notes": "Computed as a snapshot at each sampled step; aggregation scope is individual fish within each run_id and step. No time pooling and no event window are applied. Fish rows are selected by role == 'fish'; shark rows are excluded. Missing or non-finite coordinates are excluded pairwise before taking the minimum. No group identifiers are used.",
      "required_data": {
        "agent_states": [
          "run_id",
          "step",
          "agent_id",
          "role",
          "x",
          "y"
        ]
      },
      "required": {
        "agent_states": [
          "run_id",
          "step",
          "agent_id",
          "role",
          "x",
          "y"
        ]
      },
      "config": {},
      "python_code": "import numpy as np\nimport pandas as pd\nfrom scipy.spatial.distance import cdist\n\n\ndef compute_indicator(data, config):\n    df = data[\"agent_states\"][[\"run_id\", \"step\", \"agent_id\", \"role\", \"x\", \"y\"]]\n    df = df[df[\"role\"] == \"fish\"].copy()\n    df = df.dropna(subset=[\"step\", \"agent_id\"])\n    df[\"step\"] = pd.to_numeric(df[\"step\"], errors=\"coerce\")\n    df = df.dropna(subset=[\"step\"])\n    df[\"step\"] = df[\"step\"].astype(\"int64\")\n    df[\"x\"] = pd.to_numeric(df[\"x\"], errors=\"coerce\")\n    df[\"y\"] = pd.to_numeric(df[\"y\"], errors=\"coerce\")\n    df = df[np.isfinite(df[\"x\"]) & np.isfinite(df[\"y\"])].copy()\n\n    frames = []\n    for (_, step), g in df.groupby([\"run_id\", \"step\"], sort=False):\n        ids = g[\"agent_id\"].to_numpy()\n        coords = g[[\"x\", \"y\"]].to_numpy(dtype=float)\n        n = coords.shape[0]\n        if n < 2:\n            continue\n        dist = cdist(coords, coords, metric=\"euclidean\")\n        np.fill_diagonal(dist, np.inf)\n        nn = dist.min(axis=1)\n        frames.append(pd.DataFrame({\"step\": step, \"agent_id\": ids, \"value\": nn}))\n\n    if not frames:\n        index = pd.MultiIndex.from_arrays([[], []], names=[\"step\", \"agent_id\"])\n        return pd.Series(dtype=float, index=index, name=\"fish_nn_distance_micro\")\n\n    out = pd.concat(frames, ignore_index=True)\n    out = out.set_index([\"step\", \"agent_id\"])[\"value\"]\n    out.name = \"fish_nn_distance_micro\"\n    out.index = out.index.set_names([\"step\", \"agent_id\"])\n    return out\n",
      "implementation_status": "implemented",
      "failure_reason": null,
      "node_id": "fish_nn_distance_micro",
      "code_file": "\\\\?\\E:\\work\\成果\\发表论文\\Nature Communication\\abms_lab\\full_pipeline\\results\\live_fish_20261107\\internal\\stage1\\builds\\84e6aaa8ed4e0764c65dfbc60067eabac5a26619d330815bbc513df48ba7e479\\indicator_code\\fish_nn_distance_micro.py",
