  "edges": [
    {
      "edge_id": "upward__fish_nn_to_contact_fragmentation",
      "source": "fish_nn_distance_micro",
      "target": "fish_contact_fragmentation_meso",
      "scale_direction": "upward",
      "semantic_rationale": "Larger per-fish nearest-neighbor spacing implies weaker local crowding and fewer close pairwise associations; under shark-induced avoidance, fish may spread apart locally and fail to maintain contact edges, which can dynamically increase contact-graph fragmentation. This is a plausible collective consequence rather than a definitional identity, because nearest-neighbor distance and graph fragmentation are computed from different structures.",
      "relation_type": "semantic_candidate",
      "source_phenomenon": "school_fission_stretch",
      "target_phenomenon": "school_fission_stretch",
      "generation_sources": [
