<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd"><key id="d13" for="edge" attr.name="target_phenomenon" attr.type="string"/>
<key id="d12" for="edge" attr.name="source_phenomenon" attr.type="string"/>
<key id="d11" for="edge" attr.name="relation_type" attr.type="string"/>
<key id="d10" for="edge" attr.name="semantic_rationale" attr.type="string"/>
<key id="d9" for="edge" attr.name="scale_direction" attr.type="string"/>
<key id="d8" for="edge" attr.name="edge_id" attr.type="string"/>
<key id="d7" for="node" attr.name="units" attr.type="string"/>
<key id="d6" for="node" attr.name="mathematical_definition" attr.type="string"/>
<key id="d5" for="node" attr.name="description" attr.type="string"/>
<key id="d4" for="node" attr.name="phenomenon_id" attr.type="string"/>
<key id="d3" for="node" attr.name="scale" attr.type="string"/>
<key id="d2" for="node" attr.name="name" attr.type="string"/>
<key id="d1" for="graph" attr.name="schema_version" attr.type="string"/>
<key id="d0" for="graph" attr.name="evidence_status" attr.type="string"/>
<graph edgedefault="directed"><data key="d0">unvalidated_semantic_candidates</data>
<data key="d1">2.0</data>
<node id="p1_micro_new_exposure_flag">
  <data key="d2">Agent new-exposure transition indicator</data>
  <data key="d3">micro</data>
  <data key="d4">age_structured_incidence_divergence</data>
  <data key="d5">Binary per-agent, per-step indicator that an agent moves from not-exposed to exposed between two consecutively observed sampled steps of the same run.</data>
  <data key="d6">X_i(t) = 1 if exposed_i(t) = true and exposed_i(t-1) = false, otherwise 0; defined only when agent i is observed at both step t and the immediately preceding observed step t-1 in the same run; undefined if either observation is missing.</data>
  <data key="d7">indicator (0/1)</data>
</node>
<node id="p1_micro_ever_exposed_state">
  <data key="d2">Agent cumulative ever-exposed indicator</data>
  <data key="d3">micro</data>
  <data key="d4">age_structured_incidence_divergence</data>
  <data key="d5">Per-agent indicator that the agent has shown at least one observed new-exposure transition up to and including step t.</data>
  <data key="d6">E_i(t) = max over observed steps s &lt;= t in the same run of X_i(s), where X is the new-exposure transition indicator; E_i(t) = 1 if any such s has X_i(s) = 1, else 0; undefined if agent i is not observed at step t.</data>
  <data key="d7">indicator (0/1)</data>
</node>
<node id="p1_meso_band_exposure_hazard">
  <data key="d2">Age-band exposure hazard per susceptible person-step</data>
  <data key="d3">meso</data>
  <data key="d4">age_structured_incidence_divergence</data>
  <data key="d5">Rate of new observed exposure transitions in an age band normalised by the susceptible person-steps accumulated by that band at the previous observed step.</data>
  <data key="d6">h_b(t) = sum over agents i in band b of X_i(t) divided by sum over agents i in band b of S_i(t-1), where S_i(t-1) = susceptible_i(t-1) as a 0/1 quantity; undefined when the denominator is 0 or when t-1 is not observed.</data>
  <data key="d7">exposures per susceptible person-step</data>
</node>
<node id="p1_meso_band_attack_ratio">
  <data key="d2">Age-band cumulative attack ratio</data>
  <data key="d3">meso</data>
  <data key="d4">age_structured_incidence_divergence</data>
  <data key="d5">Fraction of agents ever observed in an age band that show a new-exposure transition by step t.</data>
  <data key="d6">A_b(t) = count of agents i in band b with E_i(t) = 1 divided by count of agents i in band b observed in at least one step s &lt;= t; undefined when the denominator is 0.</data>
  <data key="d7">proportion</data>
</node>
<node id="p1_meso_band_hazard_dispersion">
  <data key="d2">Cross-band dispersion of exposure hazard</data>
  <data key="d3">meso</data>
  <data key="d4">age_structured_incidence_divergence</data>
  <data key="d5">Coefficient of variation of age-band exposure hazards at a step, expressing how unequally exposure pressure is distributed across age bands.</data>
  <data key="d6">CV(t) = SD_b(h_b(t)) / mean_b(h_b(t)), with the standard deviation and mean taken over bands b whose hazard h_b(t) is defined; undefined when fewer than two bands are defined or when the mean is 0.</data>
  <data key="d7">dimensionless ratio</data>
</node>
<node id="p1_macro_band_attack_range">
  <data key="d2">Age-band attack ratio range</data>
  <data key="d3">macro</data>
  <data key="d4">age_structured_incidence_divergence</data>
  <data key="d5">Spread between the most and least affected age bands in cumulative attack ratio at a step.</data>
  <data key="d6">R(t) = max_b A_b(t) - min_b A_b(t) over bands with defined A_b(t); undefined when fewer than two bands are defined.</data>
  <data key="d7">proportion difference</data>
</node>
<node id="p1_macro_band_composition_mismatch">
  <data key="d2">Exposure-share versus susceptible-person-time mismatch</data>
  <data key="d3">macro</data>
  <data key="d4">age_structured_incidence_divergence</data>
  <data key="d5">Total variation distance between the age composition of new exposures and the age composition of susceptible person-time at the same step.</data>
  <data key="d6">M(t) = 0.5 * sum over bands b of |e_b(t) - s_b(t)|, where e_b(t) is the band share of new exposure transitions at t and s_b(t) is the band share of susceptible person-steps at t; undefined when either total is 0.</data>
  <data key="d7">dimensionless (0 to 1)</data>
</node>
<node id="p2_micro_layer_degree">
  <data key="d2">Agent contact degree within a contact layer</data>
  <data key="d3">micro</data>
  <data key="d4">setting_specific_cluster_persistence</data>
  <data key="d5">Number of recorded contact edges incident to an agent in a given layer at a sampled step, treating edges as undirected.</data>
  <data key="d6">d_i,l(t) = number of distinct contact records at step t in layer l with agent_id = i plus those with partner_id = i, de-duplicated by unordered pair so that a reciprocal pair counts once; undefined if agent i is not observed at step t.</data>
  <data key="d7">edges</data>
</node>
<node id="p2_micro_layer_exposure_flag">
  <data key="d2">Agent exposure transition attributed to a layer</data>
  <data key="d3">micro</data>
  <data key="d4">setting_specific_cluster_persistence</data>
  <data key="d5">Indicator that an agent's new-exposure transition at a step is attributed to a specific contact layer.</data>
  <data key="d6">E_i,l(t) = 1 if X_i(t) = 1 and the layer recorded on the exposure event for that agent and step equals l; 0 if X_i(t) = 1 and the recorded layer is non-null and different from l; undefined if X_i(t) = 0, if the recorded layer is null, or if no exposure event can be matched.</data>
  <data key="d7">indicator (0/1)</data>
</node>
<node id="p2_micro_layer_beta_load">
  <data key="d2">Agent per-layer contact weight load</data>
  <data key="d3">micro</data>
  <data key="d4">setting_specific_cluster_persistence</data>
  <data key="d5">Sum of recorded contact edge weights incident to an agent within a layer at a step, a structural exposure load rather than a realised transmission probability.</data>
  <data key="d6">W_i,l(t) = sum of beta over the undirected contact edges at step t in layer l incident to agent i; undefined if agent i is not observed at step t.</data>
  <data key="d7">dimensionless weight sum</data>
</node>
<node id="p2_meso_layer_incidence_per_edge">
  <data key="d2">Layer exposure incidence per contact edge</data>
  <data key="d3">meso</data>
  <data key="d4">setting_specific_cluster_persistence</data>
  <data key="d5">Layer-level rate of attributed new-exposure transitions per recorded contact edge at the same step.</data>
  <data key="d6">lambda_l(t) = (sum over agents i of E_i,l(t)) / N_l(t), where N_l(t) is the number of distinct undirected edges recorded in layer l at step t; undefined when N_l(t) = 0.</data>
  <data key="d7">exposures per edge-step</data>
</node>
<node id="p2_meso_layer_degree_dispersion">
  <data key="d2">Within-layer degree dispersion</data>
  <data key="d3">meso</data>
  <data key="d4">setting_specific_cluster_persistence</data>
  <data key="d5">Coefficient of variation of agent contact degree inside a layer, capturing how unevenly layer membership is distributed among agents.</data>
  <data key="d6">CV_l(t) = SD_i(d_i,l(t)) / mean_i(d_i,l(t)) over agents observed at step t in layer l; undefined when fewer than two agents have defined degree or when the mean is 0.</data>
  <data key="d7">dimensionless ratio</data>
</node>
<node id="p2_meso_layer_active_run">
  <data key="d2">Layer consecutive active-step run length</data>
  <data key="d3">meso</data>
  <data key="d4">setting_specific_cluster_persistence</data>
  <data key="d5">Number of consecutive observed steps ending at t during which a layer records at least one attributed exposure transition, a duration measure of layer-level cluster activity.</data>
  <data key="d6">L_l(t) = k where k is the largest integer such that for every observed step s in the k consecutive observed steps ending at t, sum over i of E_i,l(s) &gt; 0; L_l(t) = 0 if the layer has no attributed exposure at t; undefined if step t is not observed.</data>
  <data key="d7">steps</data>
</node>
<node id="p2_macro_layer_edge_turnover">
  <data key="d2">Layer edge-set Jaccard turnover</data>
  <data key="d3">macro</data>
  <data key="d4">setting_specific_cluster_persistence</data>
  <data key="d5">Jaccard distance between the undirected edge sets of a layer at consecutive sampled steps, measuring structural churn of that contact setting.</data>
  <data key="d6">J_l(t) = 1 - |A_l(t) intersect A_l(t-1)| / |A_l(t) union A_l(t-1)|, where A_l(t) is the set of unordered agent pairs recorded as edges in layer l at step t; undefined when the union is empty or t-1 is not observed.</data>
  <data key="d7">proportion (0 to 1)</data>
</node>
<node id="p2_macro_layer_incidence_entropy">
  <data key="d2">Normalised entropy of layer exposure shares</data>
  <data key="d3">macro</data>
  <data key="d4">setting_specific_cluster_persistence</data>
  <data key="d5">Normalised entropy of the distribution of attributed new-exposure transitions across contact layers at a step, expressing how concentrated infection activity is in particular settings.</data>
  <data key="d6">H(t) = -(sum over layers l of p_l(t) * ln p_l(t)) / ln(n(t)), where p_l(t) is the share of layer-attributed exposure transitions at t falling in layer l and n(t) is the number of layers with non-zero share; undefined when n(t) &lt; 2.</data>
  <data key="d7">dimensionless (0 to 1)</data>
</node>
<node id="p3_micro_household_degree">
  <data key="d2">Agent degree in the persistent household layer</data>
  <data key="d3">micro</data>
  <data key="d4">household_secondary_attack_concentration</data>
  <data key="d5">Undirected contact degree of an agent inside the layer identified empirically as the most persistent contact setting, a stand-in for the household environment.</data>
  <data key="d6">d_i,H(t) = number of distinct undirected contact pairs at step t in layer l_H incident to agent i; l_H is the layer value with the largest mean consecutive-step Jaccard overlap of its edge set over all observed steps in the run; undefined if agent i is not observed at step t.</data>
  <data key="d7">edges</data>
</node>
<node id="p3_micro_attributed_exposure_flag">
  <data key="d2">Agent source-attributed exposure indicator</data>
  <data key="d3">micro</data>
  <data key="d4">household_secondary_attack_concentration</data>
  <data key="d5">Indicator that an agent's new-exposure transition carries a recorded source agent, separating traced secondary exposures from exposures with no recorded source.</data>
  <data key="d6">A_i(t) = 1 if X_i(t) = 1 and the matched exposure event has a non-null partner_id; undefined if X_i(t) = 0 or if the matched event has a null partner_id, since no source can be resolved.</data>
  <data key="d7">indicator (0/1)</data>
</node>
<node id="p3_micro_household_attributed_flag">
  <data key="d2">Agent household-attributed exposure indicator</data>
  <data key="d3">micro</data>
  <data key="d4">household_secondary_attack_concentration</data>
  <data key="d5">Indicator that an agent's new-exposure transition is source-attributed and recorded in the persistent household-like layer.</data>
  <data key="d6">H_i(t) = 1 if A_i(t) = 1 and the layer recorded on that exposure event equals l_H; 0 if A_i(t) = 1 and the layer is non-null and different from l_H; undefined if A_i(t) is undefined.</data>
  <data key="d7">indicator (0/1)</data>
</node>
<node id="p3_meso_dyad_secondary_count">
  <data key="d2">Household dyad attributed secondary exposure count</data>
  <data key="d3">meso</data>
  <data key="d4">household_secondary_attack_concentration</data>
  <data key="d5">Number of source-attributed exposure transitions recorded within a specific undirected household-layer dyad at a step.</data>
  <data key="d6">N_uv(t) = number of exposure events at step t with non-null partner_id whose unordered endpoint pair equals {u,v}, restricted to dyads {u,v} recorded as edges in layer l_H at step t; 0 for a listed dyad with no such event.</data>
  <data key="d7">events per dyad-step</data>
</node>
<node id="p3_meso_dyad_secondary_dispersion">
  <data key="d2">Dispersion of attributed exposures across household dyads</data>
  <data key="d3">meso</data>
  <data key="d4">household_secondary_attack_concentration</data>
  <data key="d5">Coefficient of variation of cumulative attributed exposure counts across household-layer dyads, showing whether secondary exposures concentrate in few dyads.</data>
  <data key="d6">CV(t) = SD_dyad(C_uv(t)) / mean_dyad(C_uv(t)), where C_uv(t) is the cumulative count of source-attributed exposure events in dyad {u,v} over observed steps up to t, taken over dyads recorded in layer l_H at any observed step up to t; undefined when fewer than two dyads or when the mean is 0.</data>
  <data key="d7">dimensionless ratio</data>
</node>
<node id="p3_meso_dyad_attack_fraction">
  <data key="d2">Fraction of household dyads with any attributed exposure</data>
  <data key="d3">meso</data>
  <data key="d4">household_secondary_attack_concentration</data>
  <data key="d5">Share of household-layer dyads that have accumulated at least one source-attributed exposure event by a step.</data>
  <data key="d6">F(t) = count of dyads {u,v} recorded in l_H up to t with C_uv(t) &gt;= 1 divided by count of dyads recorded in l_H up to t; undefined when the denominator is 0.</data>
  <data key="d7">proportion</data>
</node>
<node id="p3_macro_household_attributed_fraction">
  <data key="d2">Household share of all observed exposure transitions</data>
  <data key="d3">macro</data>
  <data key="d4">household_secondary_attack_concentration</data>
  <data key="d5">Proportion of all observed new-exposure transitions at a step that are attributed to the household-like layer.</data>
  <data key="d6">f(t) = (sum over agents i of H_i(t)) / (sum over agents i of X_i(t)); undefined when the denominator is 0.</data>
  <data key="d7">proportion</data>
</node>
<node id="p3_macro_dyad_attribution_gini">
  <data key="d2">Gini concentration of household dyad attributed exposures</data>
  <data key="d3">macro</data>
  <data key="d4">household_secondary_attack_concentration</data>
  <data key="d5">Gini coefficient of cumulative source-attributed exposure counts across household-layer dyads, measuring how unequally secondary exposures are distributed.</data>
  <data key="d6">G(t) = (sum over dyads j of sum over dyads k of |C_j(t) - C_k(t)|) / (2 * n(t)^2 * mean_dyad(C(t))), where C_j(t) are cumulative dyad counts over dyads recorded up to t and n(t) is the number of such dyads; undefined when n(t) &lt; 2 or the mean is 0.</data>
  <data key="d7">dimensionless (0 to 1)</data>
</node>
<node id="p4_micro_silent_infectious_flag">
  <data key="d2">Agent silent-infectious indicator</data>
  <data key="d3">micro</data>
  <data key="d4">silent_transmission_masking</data>
  <data key="d5">Indicator that an agent is currently infectious while not carrying a diagnosed state, i.e. infection activity not yet visible to surveillance.</data>
  <data key="d6">Z_i(t) = 1 if infectious_i(t) = true and diagnosed_i(t) = false; 0 if infectious_i(t) = true and diagnosed_i(t) = true; undefined if infectious_i(t) = false or the agent is not observed at t.</data>
  <data key="d7">indicator (0/1)</data>
</node>
<node id="p4_micro_silent_infectious_duration">
  <data key="d2">Agent cumulative silent-infectious duration</data>
  <data key="d3">micro</data>
  <data key="d4">silent_transmission_masking</data>
  <data key="d5">Number of observed steps up to t on which an agent has been silently infectious, a duration of undetected infectious activity.</data>
  <data key="d6">D_i(t) = number of observed steps s &lt;= t in the same run with Z_i(s) = 1; undefined if agent i is not observed at t.</data>
  <data key="d7">agent-steps</data>
</node>
<node id="p4_micro_symptomatic_undiagnosed_flag">
  <data key="d2">Agent symptomatic-but-undiagnosed indicator</data>
  <data key="d3">micro</data>
  <data key="d4">silent_transmission_masking</data>
  <data key="d5">Indicator that an agent shows a symptomatic state without a diagnosed state at the same step, separating symptom-driven from fully hidden activity.</data>
  <data key="d6">Y_i(t) = 1 if symptomatic_i(t) = true and diagnosed_i(t) = false; 0 if symptomatic_i(t) = true and diagnosed_i(t) = true; undefined if symptomatic_i(t) = false or the agent is not observed.</data>
  <data key="d7">indicator (0/1)</data>
</node>
<node id="p4_meso_group_silent_share">
  <data key="d2">Silent share of infectious person-steps by quarantine-status group</data>
  <data key="d3">meso</data>
  <data key="d4">silent_transmission_masking</data>
  <data key="d5">Within quarantine-status groups, the fraction of infectious person-steps that are undiagnosed, showing whether activity reduction tracks surveillance visibility.</data>
  <data key="d6">For group g at step t: q_g(t) = (sum over agents i in g at t of Z_i(t)) / (sum over agents i in g at t of 1[infectious_i(t)]); undefined when the denominator is 0.</data>
  <data key="d7">proportion</data>
</node>
<node id="p4_meso_group_exposure_yield_silent">
  <data key="d2">Exposures generated per silent infectious person-step by group</data>
  <data key="d3">meso</data>
  <data key="d4">silent_transmission_masking</data>
  <data key="d5">Rate at which new observed exposure transitions accumulate in a quarantine-status group per silent infectious person-step in that group.</data>
  <data key="d6">y_g(t) = (sum over agents i in group g of X_i(t)) / (sum over agents i in group g of Z_i(t)); undefined when the denominator is 0.</data>
  <data key="d7">exposures per silent infectious person-step</data>
</node>
<node id="p4_macro_detection_coverage_rate">
  <data key="d2">New diagnoses per infectious person-step</data>
  <data key="d3">macro</data>
  <data key="d4">silent_transmission_masking</data>
  <data key="d5">Rate at which new diagnosed transitions occur relative to current infectious person-steps, an inverse-scale measure of how much infectious activity surveillance sees.</data>
  <data key="d6">c(t) = (number of agents with diagnosed transition 1 at step t, i.e. diagnosed_i(t) = true and diagnosed_i(t-1) = false) / (number of agents with infectious_i(t) = true); undefined when the denominator is 0 or t-1 is not observed.</data>
  <data key="d7">diagnoses per infectious person-step</data>
</node>
<node id="p4_macro_silent_prevalence_share">
  <data key="d2">Silent share of current infectious agents</data>
  <data key="d3">macro</data>
  <data key="d4">silent_transmission_masking</data>
  <data key="d5">Proportion of currently infectious agents that are undiagnosed at a step, the standing size of the invisible infectious pool.</data>
  <data key="d6">s(t) = (sum over agents i of Z_i(t)) / (sum over agents i of 1[infectious_i(t) = true]); undefined when the denominator is 0.</data>
  <data key="d7">proportion</data>
</node>
<node id="p4_macro_masking_ratio">
  <data key="d2">Cumulative never-diagnosed to ever-diagnosed infection ratio</data>
  <data key="d3">macro</data>
  <data key="d4">silent_transmission_masking</data>
  <data key="d5">Ratio of ever-exposed agents that have never been diagnosed by t to those that have, a scale of accumulated observational masking.</data>
  <data key="d6">U(t) = count of agents i with E_i(t) = 1 and no diagnosed_i(s) = true for any observed s &lt;= t, divided by count of agents i with E_i(t) = 1 and at least one diagnosed_i(s) = true for some s &lt;= t; undefined when the denominator is 0.</data>
  <data key="d7">ratio</data>
</node>
<node id="p4_macro_symptom_to_diagnosis_lag">
  <data key="d2">Mean recorded symptom-to-diagnosis interval</data>
  <data key="d3">macro</data>
  <data key="d4">silent_transmission_masking</data>
  <data key="d5">Average gap between the native symptomatic date and the native diagnosed date for agents newly diagnosed at a step, indicating how long symptomatic infection stays undetected.</data>
  <data key="d6">L(t) = mean over agents i diagnosed newly at step t, with both date_symptomatic and date_diagnosed non-null, of (date_diagnosed_i - date_symptomatic_i); undefined when no agent qualifies.</data>
  <data key="d7">days</data>
</node>
<node id="p5_micro_known_contact_flag">
  <data key="d2">Agent known-contact state indicator</data>
  <data key="d3">micro</data>
  <data key="d4">tracing_capacity_saturation</data>
  <data key="d5">Whether an agent currently carries the known-contact flag used by contact tracing, per sampled step.</data>
  <data key="d6">K_i(t) = 1 if known_contact_i(t) = true, 0 if known_contact_i(t) = false; undefined if agent i is not observed at step t.</data>
  <data key="d7">indicator (0/1)</data>
</node>
<node id="p5_micro_tracing_latency">
  <data key="d2">Agent known-contact to quarantine latency</data>
  <data key="d3">micro</data>
  <data key="d4">tracing_capacity_saturation</data>
  <data key="d5">Interval between an agent's recorded known-contact date and recorded quarantine start date, a per-agent tracing delay.</data>
  <data key="d6">Tau_i = date_quarantined_i - date_known_contact_i for agent i, defined only when both native dates are non-null for that agent in the run; undefined otherwise.</data>
  <data key="d7">days</data>
</node>
<node id="p5_micro_quarantine_flag">
  <data key="d2">Agent quarantine state indicator</data>
  <data key="d3">micro</data>
  <data key="d4">tracing_capacity_saturation</data>
  <data key="d5">Whether an agent is in a quarantined state at a sampled step.</data>
  <data key="d6">Q_i(t) = 1 if quarantined_i(t) = true, 0 if quarantined_i(t) = false; undefined if agent i is not observed at step t.</data>
  <data key="d7">indicator (0/1)</data>
</node>
<node id="p5_meso_layer_known_contact_rate">
  <data key="d2">Layer known-contact incidence per contact edge</data>
  <data key="d3">meso</data>
  <data key="d4">tracing_capacity_saturation</data>
  <data key="d5">Rate at which known-contact status changes are recorded in a layer relative to the edges that layer supplies, capturing per-setting tracing yield.</data>
  <data key="d6">r_l(t) = (number of agents i with a known-contact transition at step t, i.e. known_contact_i(t) = true and known_contact_i(t-1) = false, whose layer-attributed record is l) / N_l(t), where N_l(t) is the number of distinct undirected edges in layer l at step t; undefined when N_l(t) = 0 or t-1 is not observed.</data>
  <data key="d7">transitions per edge-step</data>
</node>
<node id="p5_meso_layer_index_contact_load">
  <data key="d2">Per-index contact load within a layer</data>
  <data key="d3">meso</data>
  <data key="d4">tracing_capacity_saturation</data>
  <data key="d5">Average number of layer edges that must be examined per newly quarantined agent at a step, a workload measure per setting.</data>
  <data key="d6">w_l(t) = (sum over agents i newly quarantined at t of d_i,l(t)) / (number of agents newly quarantined at t), where newly quarantined means quarantined_i(t) = true and quarantined_i(t-1) = false; undefined when no agent is newly quarantined or t-1 is not observed.</data>
  <data key="d7">edges per index agent</data>
</node>
<node id="p5_meso_layer_load_dispersion">
  <data key="d2">Cross-layer dispersion of contact load</data>
  <data key="d3">meso</data>
  <data key="d4">tracing_capacity_saturation</data>
  <data key="d5">Coefficient of variation of per-index contact load across layers at a step, showing whether tracing burden concentrates in particular settings.</data>
  <data key="d6">CV(t) = SD_l(w_l(t)) / mean_l(w_l(t)) over layers with defined w_l(t); undefined when fewer than two layers are defined or the mean is 0.</data>
  <data key="d7">dimensionless ratio</data>
</node>
<node id="p5_macro_traced_per_diagnosis">
  <data key="d2">Known-contact transitions per new diagnosis</data>
  <data key="d3">macro</data>
  <data key="d4">tracing_capacity_saturation</data>
  <data key="d5">Number of newly flagged contacts generated per newly diagnosed agent at a step, an operational tracing-load ratio.</data>
  <data key="d6">P(t) = (number of agents with a known-contact transition at t) / (number of agents with a diagnosed transition at t); undefined when the diagnosis denominator is 0 or t-1 is not observed.</data>
  <data key="d7">contacts per diagnosis</data>
</node>
<node id="p5_macro_mean_tracing_latency">
  <data key="d2">Mean per-agent tracing latency at quarantine start</data>
  <data key="d3">macro</data>
  <data key="d4">tracing_capacity_saturation</data>
  <data key="d5">Average known-contact-to-quarantine interval among agents whose quarantine start is first observed at a step.</data>
  <data key="d6">Lambda(t) = mean over agents i with quarantined_i(t) = true and quarantined_i(t-1) = false and defined Tau_i of Tau_i; undefined when no such agent has a defined latency.</data>
  <data key="d7">days</data>
</node>
<node id="p5_macro_quarantine_coverage">
  <data key="d2">Quarantine coverage of observed agent-steps</data>
  <data key="d3">macro</data>
  <data key="d4">tracing_capacity_saturation</data>
  <data key="d5">Share of observed agent-steps spent in a quarantined state, a population-level measure of how much activity restriction tracing achieves.</data>
  <data key="d6">C(t) = (number of agents i observed at step t with quarantined_i(t) = true) / (number of agents observed at step t); undefined when no agent is observed.</data>
  <data key="d7">proportion</data>
</node>
<node id="p5_macro_known_contact_prevalence">
  <data key="d2">Known-contact prevalence share</data>
  <data key="d3">macro</data>
  <data key="d4">tracing_capacity_saturation</data>
  <data key="d5">Share of observed agents concurrently flagged as known contacts at a step, the standing tracing caseload.</data>
  <data key="d6">K(t) = (number of agents i observed at step t with known_contact_i(t) = true) / (number of agents observed at step t); undefined when no agent is observed.</data>
  <data key="d7">proportion</data>
</node>
<node id="p6_micro_quarantine_contact_ratio">
  <data key="d2">Agent contact degree ratio in and out of quarantine</data>
  <data key="d3">micro</data>
  <data key="d4">adherence_heterogeneity_feedback</data>
  <data key="d5">Ratio of an agent's mean contact degree while quarantined to its mean degree while not quarantined, a per-agent adherence proxy.</data>
  <data key="d6">rho_i = (mean over observed steps s with quarantined_i(s) = true of d_i(s)) / (mean over observed steps s with quarantined_i(s) = false of d_i(s)); undefined when either step set is empty or the non-quarantine mean is 0.</data>
  <data key="d7">ratio</data>
</node>
<node id="p6_micro_quarantine_degree_delta">
  <data key="d2">Agent absolute contact-degree change under quarantine</data>
  <data key="d3">micro</data>
  <data key="d4">adherence_heterogeneity_feedback</data>
  <data key="d5">Difference between an agent's mean contact degree while quarantined and while not quarantined, in edge units.</data>
  <data key="d6">delta_i = (mean over observed steps with quarantined_i = true of d_i) - (mean over observed steps with quarantined_i = false of d_i); undefined when either step set is empty.</data>
  <data key="d7">edges</data>
</node>
<node id="p6_micro_zero_contact_quarantined_flag">
  <data key="d2">Agent full-contact-suppression indicator under quarantine</data>
  <data key="d3">micro</data>
  <data key="d4">adherence_heterogeneity_feedback</data>
  <data key="d5">Indicator that a quarantined agent records no contact edges at a step, the strongest observable form of adherence.</data>
  <data key="d6">Z_i(t) = 1 if quarantined_i(t) = true and d_i(t) = 0; 0 if quarantined_i(t) = true and d_i(t) &gt; 0; undefined if quarantined_i(t) = false or the agent is not observed at t.</data>
  <data key="d7">indicator (0/1)</data>
</node>
<node id="p6_meso_quarantined_degree_dispersion">
  <data key="d2">Dispersion of contact degree among quarantined agents</data>
  <data key="d3">meso</data>
  <data key="d4">adherence_heterogeneity_feedback</data>
  <data key="d5">Coefficient of variation of contact degree across currently quarantined agents, measuring heterogeneity of behavioural response.</data>
  <data key="d6">CV(t) = SD_i(d_i(t)) / mean_i(d_i(t)) over agents observed at step t with quarantined_i(t) = true; undefined when fewer than two such agents or the mean is 0.</data>
  <data key="d7">dimensionless ratio</data>
</node>
<node id="p6_meso_layer_quarantine_suppression_ratio">
  <data key="d2">Layer-level degree suppression ratio under quarantine</data>
  <data key="d3">meso</data>
  <data key="d4">adherence_heterogeneity_feedback</data>
  <data key="d5">Ratio of mean in-layer degree of quarantined agents to that of non-quarantined agents in the same layer at the same step.</data>
  <data key="d6">sigma_l(t) = (mean over quarantined agents at t of d_i,l(t)) / (mean over non-quarantined agents at t of d_i,l(t)); undefined when either group is empty in that layer or the denominator mean is 0.</data>
  <data key="d7">ratio</data>
</node>
<node id="p6_macro_contact_volume_change">
  <data key="d2">Relative step-to-step change in total contact volume</data>
  <data key="d3">macro</data>
  <data key="d4">adherence_heterogeneity_feedback</data>
  <data key="d5">Relative first difference of total recorded contact edges between consecutive observed steps, capturing population-wide activity change.</data>
  <data key="d6">G(t) = (E(t) - E(t-1)) / E(t-1), where E(t) is the number of distinct undirected edges at step t over all layers; undefined when E(t-1) = 0 or t-1 is not observed.</data>
  <data key="d7">per-step relative change</data>
</node>
<node id="p6_macro_adherence_share">
  <data key="d2">Share of quarantined agents at or below the non-quarantined median degree</data>
  <data key="d3">macro</data>
  <data key="d4">adherence_heterogeneity_feedback</data>
  <data key="d5">Fraction of quarantined agents whose contact degree does not exceed the median degree of non-quarantined agents at the same step, a data-anchored compliance share.</data>
  <data key="d6">A(t) = (count of agents i with quarantined_i(t) = true and d_i(t) &lt;= m(t)) / (count of agents with quarantined_i(t) = true), where m(t) is the median of d_j(t) over agents with quarantined_j(t) = false at step t; undefined when either count is 0.</data>
  <data key="d7">proportion</data>
</node>
<node id="p6_macro_population_suppression_ratio">
  <data key="d2">Population-level quarantine contact suppression ratio</data>
  <data key="d3">macro</data>
  <data key="d4">adherence_heterogeneity_feedback</data>
  <data key="d5">Ratio of mean contact degree of quarantined agents to mean contact degree of non-quarantined agents across all layers at a step.</data>
  <data key="d6">Sigma(t) = (mean of d_i(t) over agents with quarantined_i(t) = true) / (mean of d_i(t) over agents with quarantined_i(t) = false); undefined when either group is empty or the denominator mean is 0.</data>
  <data key="d7">ratio</data>
</node>
<node id="p7_micro_exposure_step_index">
  <data key="d2">Agent first observed exposure step index</data>
  <data key="d3">micro</data>
  <data key="d4">intervention_timing_cohort_shift</data>
  <data key="d5">Sampling step at which an agent first shows a new-exposure transition, expressing cohort membership in the run's own step coordinate.</data>
  <data key="d6">t_i = min over observed steps s in the run with X_i(s) = 1 of s; undefined for agents with no observed exposure transition.</data>
  <data key="d7">step index</data>
</node>
<node id="p7_micro_exposure_to_diagnosis_interval">
  <data key="d2">Agent exposure-to-diagnosis interval</data>
  <data key="d3">micro</data>
  <data key="d4">intervention_timing_cohort_shift</data>
  <data key="d5">Recorded interval between an agent's native exposure date and native diagnosis date, a per-agent delay that can shift between cohorts.</data>
  <data key="d6">I_i = date_diagnosed_i - date_exposed_i, defined only when both native dates are non-null for agent i; undefined otherwise.</data>
  <data key="d7">days</data>
</node>
<node id="p7_meso_band_exposure_share">
  <data key="d2">Age-band share of new exposure transitions</data>
  <data key="d3">meso</data>
  <data key="d4">intervention_timing_cohort_shift</data>
  <data key="d5">Share of a step's new exposure transitions that falls in each age band, the group-level composition of incident infection activity.</data>
  <data key="d6">p_b(t) = (sum over agents i in band b of X_i(t)) / (sum over all bands of the same sum); undefined when the denominator is 0.</data>
  <data key="d7">proportion</data>
</node>
<node id="p7_meso_layer_exposure_share">
  <data key="d2">Layer share of attributed new exposure transitions</data>
  <data key="d3">meso</data>
  <data key="d4">intervention_timing_cohort_shift</data>
  <data key="d5">Share of a step's layer-attributed exposure transitions that occurs in each contact layer, the setting-level composition of incident activity.</data>
  <data key="d6">q_l(t) = (sum over agents i of E_i,l(t)) / (sum over all layers of the same sum); undefined when the denominator is 0.</data>
  <data key="d7">proportion</data>
</node>
<node id="p7_meso_band_share_drift">
  <data key="d2">Age-band exposure share drift from first active step</data>
  <data key="d3">meso</data>
  <data key="d4">intervention_timing_cohort_shift</data>
  <data key="d5">Absolute change in an age band's share of exposure transitions between the first step with any exposure transition and the current step.</data>
  <data key="d6">D_b(t) = |p_b(t) - p_b(t0)|, where t0 is the earliest observed step in the run with at least one exposure transition; undefined when p_b(t) or p_b(t0) is undefined.</data>
  <data key="d7">proportion difference</data>
</node>
<node id="p7_macro_age_composition_drift">
  <data key="d2">Total-variation drift of age composition of exposures</data>
  <data key="d3">macro</data>
  <data key="d4">intervention_timing_cohort_shift</data>
  <data key="d5">Total variation distance between the age composition of exposure transitions at the current step and at the first step with any exposure transition.</data>
  <data key="d6">V_age(t) = 0.5 * sum over bands b of |p_b(t) - p_b(t0)|, with t0 the earliest observed step having at least one exposure transition; undefined when t0 or t is not observed or the step has no exposures.</data>
  <data key="d7">dimensionless (0 to 1)</data>
</node>
<node id="p7_macro_layer_composition_drift">
  <data key="d2">Total-variation drift of layer composition of attributed exposures</data>
  <data key="d3">macro</data>
  <data key="d4">intervention_timing_cohort_shift</data>
  <data key="d5">Total variation distance between the layer composition of attributed exposure transitions at the current step and at the first step with any attributed exposure.</data>
  <data key="d6">V_layer(t) = 0.5 * sum over layers l of |q_l(t) - q_l(t1)|, with t1 the earliest observed step having at least one layer-attributed exposure transition; undefined when either step lacks attributed exposures.</data>
  <data key="d7">dimensionless (0 to 1)</data>
</node>
<node id="p7_macro_growth_change_at_first_quarantine">
  <data key="d2">Contrast of exposure growth before and after first quarantine onset</data>
  <data key="d3">macro</data>
  <data key="d4">intervention_timing_cohort_shift</data>
  <data key="d5">Difference between mean per-step logarithmic growth of exposure transitions after the first observed quarantine onset and before it, describing the timing-associated change in the growth regime.</data>
  <data key="d6">g_before = mean over observed steps s &lt; tq with positive counts n(s-1), n(s) of ln(n(s)/n(s-1)); g_after = the analogous mean over observed steps s &gt; tq; variable = g_after - g_before, where n(t) is the number of exposure transitions at t and tq is the earliest observed step with at least one quarantine transition; undefined if either segment is empty or any needed count is 0.</data>
  <data key="d7">per-step log-growth difference</data>
</node>
<node id="p7_macro_median_age_of_new_exposures">
  <data key="d2">Median age of agents with new exposure transitions</data>
  <data key="d3">macro</data>
  <data key="d4">intervention_timing_cohort_shift</data>
  <data key="d5">Median age among agents showing a new-exposure transition at a step, tracking the shifting age profile of incident infection activity.</data>
  <data key="d6">m(t) = median of age_i over agents i observed at step t with X_i(t) = 1; undefined when no agent has a defined exposure transition and age at that step.</data>
  <data key="d7">years (age units as recorded)</data>
</node>
<node id="p8_micro_offset_from_infectious_trough">
  <data key="d2">Agent exposure-step offset from the city infectious trough</data>
  <data key="d3">micro</data>
  <data key="d4">community_resurgence_after_decline</data>
  <data key="d5">Signed distance in sampled steps between an agent's first observed exposure and the step of minimum city-wide infectious prevalence.</data>
  <data key="d6">o_i = t_i - t*, where t_i is the agent's first observed exposure step and t* is the observed step of minimum count of agents with infectious_i(t) = true within the run (earliest such step on ties); undefined when t_i is undefined or t* is undefined.</data>
  <data key="d7">steps</data>
</node>
<node id="p8_micro_post_trough_exposure_flag">
  <data key="d2">Agent exposure transition after the infectious trough</data>
  <data key="d3">micro</data>
  <data key="d4">community_resurgence_after_decline</data>
  <data key="d5">Indicator that an agent's new-exposure transition occurs strictly after the observed city-wide infectious minimum.</data>
  <data key="d6">R_i(t) = 1 if X_i(t) = 1 and t &gt; t*; 0 if X_i(t) = 1 and t &lt;= t*; undefined if X_i(t) = 0 or t* is undefined.</data>
  <data key="d7">indicator (0/1)</data>
</node>
<node id="p8_meso_layer_post_trough_incidence_ratio">
  <data key="d2">Layer attributed-exposure rate ratio after versus at the trough</data>
  <data key="d3">meso</data>
  <data key="d4">community_resurgence_after_decline</data>
  <data key="d5">Ratio of a layer's mean attributed exposure incidence after the infectious trough to its incidence at the trough step.</data>
  <data key="d6">Phi_l = (mean over observed steps s &gt; t* of lambda_l(s)) / lambda_l(t*), where lambda_l(s) is attributed layer exposure incidence per edge at step s; undefined when lambda_l(t*) = 0, is undefined, or no step after t* is observed.</data>
  <data key="d7">ratio</data>
</node>
<node id="p8_meso_band_post_trough_incidence_ratio">
  <data key="d2">Age-band exposure rate ratio after versus at the trough</data>
  <data key="d3">meso</data>
  <data key="d4">community_resurgence_after_decline</data>
  <data key="d5">Ratio of an age band's mean exposure transition rate after the infectious trough to its rate at the trough step, showing whether resurgence is age-selective.</data>
  <data key="d6">Psi_b = (mean over observed steps s &gt; t* of h_b(s)) / h_b(t*), with h_b the band exposure hazard per susceptible person-step; undefined when h_b(t*) = 0, is undefined, or no step after t* is observed.</data>
  <data key="d7">ratio</data>
</node>
<node id="p8_macro_post_trough_infectious_growth">
  <data key="d2">Mean post-trough log growth of infectious agents</data>
  <data key="d3">macro</data>
  <data key="d4">community_resurgence_after_decline</data>
  <data key="d5">Average per-step logarithmic growth of the count of infectious agents over observed steps strictly after the trough.</data>
  <data key="d6">g = mean over consecutive observed step pairs (s-1, s) with s &gt; t*, I(s-1) &gt; 0 and I(s) &gt; 0 of ln(I(s)/I(s-1)), where I(s) is the count of agents with infectious_i(s) = true; undefined when no such pair exists.</data>
  <data key="d7">per-step log growth</data>
</node>
<node id="p8_macro_resurgence_amplitude">
  <data key="d2">Post-trough rebound amplitude of infectious count</data>
  <data key="d3">macro</data>
  <data key="d4">community_resurgence_after_decline</data>
  <data key="d5">Ratio of the highest infectious-agent count observed after the trough to the count at the trough, the size of the rebound.</data>
  <data key="d6">A = (max over observed steps s &gt; t* of I(s)) / I(t*); undefined when I(t*) = 0 or no step after t* is observed.</data>
  <data key="d7">ratio</data>
</node>
<node id="p8_macro_trough_susceptible_depletion">
  <data key="d2">Susceptible share at the infectious trough</data>
  <data key="d3">macro</data>
  <data key="d4">community_resurgence_after_decline</data>
  <data key="d5">Fraction of the observed agent population still susceptible at the trough step, the depletion level against which any rebound occurs.</data>
  <data key="d6">S(t*) = (number of agents i observed at t* with susceptible_i(t*) = true) / (number of agents observed at t*); undefined when t* is undefined or no agent is observed at t*.</data>
  <data key="d7">proportion</data>
</node>
<node id="p8_macro_resurgence_breadth">
  <data key="d2">Share of layers with post-trough incidence increase</data>
  <data key="d3">macro</data>
  <data key="d4">community_resurgence_after_decline</data>
  <data key="d5">Fraction of contact layers whose attributed exposure incidence is higher on average after the trough than at the trough step, describing how widespread the rebound is.</data>
  <data key="d6">B = (number of layers l with Phi_l defined and Phi_l &gt; 1) / (number of layers l with Phi_l defined); undefined when no layer has a defined ratio.</data>
  <data key="d7">proportion</data>
</node>
<edge source="p1_micro_new_exposure_flag" target="p2_meso_layer_incidence_per_edge">
  <data key="d8">upward__b00_r0000</data>
  <data key="d9">upward</data>
  <data key="d10">More per-agent new-exposure transitions raise the flow of exposure events that can be attributed to contact layers, so layer-level incidence per recorded edge can rise when these transitions cluster in a layer rather than being diffuse.</data>
  <data key="d11">semantic_candidate</data>
  <data key="d12">age_structured_incidence_divergence</data>
  <data key="d13">setting_specific_cluster_persistence</data>
</edge>
<edge source="p1_micro_new_exposure_flag" target="p3_meso_dyad_attack_fraction">
  <data key="d8">upward__b00_r0001</data>
  <data key="d9">upward</data>
  <data key="d10">New household exposures increase the chance that a household-layer dyad accumulates at least one attributed exposure, lifting the fraction of dyads with any attributed event.</data>
  <data key="d11">semantic_candidate</data>
  <data key="d12">age_structured_incidence_divergence</data>
  <data key="d13">household_secondary_attack_concentration</data>
</edge>
<edge source="p1_micro_new_exposure_flag" target="p1_meso_band_hazard_dispersion">
  <data key="d8">upward__b00_r0002</data>
  <data key="d9">upward</data>
  <data key="d10">If new exposures concentrate in some age bands, between-band exposure hazards diverge, increasing cross-band dispersion even when total exposure activity is unchanged.</data>
  <data key="d11">semantic_candidate</data>
  <data key="d12">age_structured_incidence_divergence</data>
  <data key="d13">age_structured_incidence_divergence</data>
</edge>
<edge source="p1_micro_new_exposure_flag" target="p4_meso_group_silent_share">
  <data key="d8">upward__b00_r0003</data>
  <data key="d9">upward</data>
  <data key="d10">Cohorts of new exposures later enter infectious states; if they are distributed unevenly across quarantine-status groups, the silent share of infectious person-steps in those groups can shift after the exposure-to-infectious delay.</data>
  <data key="d11">semantic_candidate</data>
  <data key="d12">age_structured_incidence_divergence</data>
  <data key="d13">silent_transmission_masking</data>
</edge>
<edge source="p1_micro_new_exposure_flag" target="p7_meso_layer_exposure_share">
  <data key="d8">upward__b00_r0004</data>
  <data key="d9">upward</data>
  <data key="d10">New exposures that are layer-attributed alter relative layer composition; an increase in exposures in one setting raises its share of attributed transitions.</data>
  <data key="d11">semantic_candidate</data>
  <data key="d12">age_structured_incidence_divergence</data>
  <data key="d13">intervention_timing_cohort_shift</data>
</edge>
<edge source="p1_micro_new_exposure_flag" target="p8_meso_layer_post_trough_incidence_ratio">
  <data key="d8">upward__b00_r0005</data>
  <data key="d9">upward</data>
  <data key="d10">Post-trough new exposures feed layer-attributed incidence after the trough; if they occur preferentially in a layer, that layer's after-versus-at-trough incidence ratio rises.</data>
  <data key="d11">semantic_candidate</data>
  <data key="d12">age_structured_incidence_divergence</data>
  <data key="d13">community_resurgence_after_decline</data>
</edge>
<edge source="p1_micro_new_exposure_flag" target="p4_micro_silent_infectious_flag">
  <data key="d8">intra_scale__b00_r0000</data>
  <data key="d9">intra_scale</data>
  <data key="d10">A new exposure transition can later manifest as infectiousness without diagnosis, raising the chance the agent enters the silent-infectious state after the biological delay.</data>
  <data key="d11">semantic_candidate</data>
  <data key="d12">age_structured_incidence_divergence</data>
  <data key="d13">silent_transmission_masking</data>
</edge>
<edge source="p1_micro_new_exposure_flag" target="p4_micro_symptomatic_undiagnosed_flag">
  <data key="d8">intra_scale__b00_r0001</data>
  <data key="d9">intra_scale</data>
  <data key="d10">Agents newly exposed can progress to symptomatic disease before being diagnosed, so exposure transitions feed later symptomatic-undiagnosed states.</data>
  <data key="d11">semantic_candidate</data>
  <data key="d12">age_structured_incidence_divergence</data>
  <data key="d13">silent_transmission_masking</data>
</edge>
<edge source="p1_micro_new_exposure_flag" target="p5_micro_quarantine_flag">
  <data key="d8">intra_scale__b00_r0002</data>
  <data key="d9">intra_scale</data>
  <data key="d10">If an exposure event is linked to a traced source or known contact investigation, the newly exposed agent may be placed under quarantine.</data>
  <data key="d11">semantic_candidate</data>
  <data key="d12">age_structured_incidence_divergence</data>
  <data key="d13">tracing_capacity_saturation</data>
</edge>
<edge source="p1_micro_new_exposure_flag" target="p7_micro_exposure_to_diagnosis_interval">
  <data key="d8">intra_scale__b00_r0003</data>
  <data key="d9">intra_scale</data>
  <data key="d10">The timing of the exposure transition sets the start of the exposure-to-diagnosis interval and can shift when diagnosis eventually occurs.</data>
  <data key="d11">semantic_candidate</data>
  <data key="d12">age_structured_incidence_divergence</data>
  <data key="d13">intervention_timing_cohort_shift</data>
</edge>
<edge source="p1_micro_new_exposure_flag" target="p5_micro_known_contact_flag">
  <data key="d8">intra_scale__b00_r0004</data>
