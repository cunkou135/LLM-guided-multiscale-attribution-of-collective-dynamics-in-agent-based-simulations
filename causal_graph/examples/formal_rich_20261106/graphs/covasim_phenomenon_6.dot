"p6_meso_layer_quarantine_suppression_ratio" -> "p6_micro_quarantine_contact_ratio" [id="edge_downward__b01_r0027", color="#b3653b", style="dashed", constraint=false];
"p6_meso_layer_quarantine_suppression_ratio" -> "p6_micro_zero_contact_quarantined_flag" [id="edge_downward__b01_r0028", color="#b3653b", style="dashed", constraint=false];
"p6_meso_layer_quarantine_suppression_ratio" -> "p6_micro_quarantine_degree_delta" [id="edge_downward__b01_r0033", color="#b3653b", style="dashed", constraint=false];
"p6_macro_contact_volume_change" -> "p6_micro_quarantine_contact_ratio" [id="edge_downward__b02_r0038", color="#b3653b", style="dashed", constraint=false];
"p6_macro_contact_volume_change" -> "p6_micro_zero_contact_quarantined_flag" [id="edge_downward__b02_r0039", color="#b3653b", style="dashed", constraint=false];
"p6_macro_adherence_share" -> "p6_micro_zero_contact_quarantined_flag" [id="edge_downward__b03_r0007", color="#b3653b", style="dashed", constraint=false];
