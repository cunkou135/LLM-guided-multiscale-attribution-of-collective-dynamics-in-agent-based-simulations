"p6_meso_quarantined_degree_dispersion" -> "p6_meso_layer_quarantine_suppression_ratio" [id="edge_intra_scale__b01_r0023", color="#6e648d", style="dotted", constraint=false];
"p6_macro_population_suppression_ratio" -> "p6_macro_contact_volume_change" [id="edge_intra_scale__b01_r0057", color="#6e648d", style="dotted", constraint=false];
