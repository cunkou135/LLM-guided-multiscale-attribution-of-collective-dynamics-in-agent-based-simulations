digraph G {
graph [rankdir=LR, newrank=true, nodesep=0.15, ranksep=0.42, splines=spline, outputorder=edgesfirst, pad=0.12, bgcolor="white", fontname="Times New Roman", fontsize=17, labelloc=t, labeljust=l, dpi=150];
node [shape=box, style="rounded,filled", fillcolor="white", color="#444444", fontname="Times New Roman", fontsize=14, margin="0.10,0.07", penwidth=1.1];
edge [arrowsize=0.7, penwidth=1.0];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD ALIGN="LEFT">Covasim | phenomenon_5</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">10 nodes / 27 edges</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#27667b">Upward: solid</FONT> | <FONT POINT-SIZE="10" COLOR="#b3653b">Downward: dashed</FONT> | <FONT POINT-SIZE="10" COLOR="#6e648d">Same scale: dotted</FONT></TD></TR></TABLE>>;
subgraph cluster_micro {
rank=same;
label="Micro"; color="#dddddd"; margin=10; fontsize=16;
"p5_micro_known_contact_flag" [id="node_p5_micro_known_contact_flag", label="N33\nAgent known-contact state\nindicator", style="rounded,filled", fillcolor="white"];
"p5_micro_tracing_latency" [id="node_p5_micro_tracing_latency", label="N34\nAgent known-contact to\nquarantine latency", style="rounded,filled", fillcolor="white"];
"p5_micro_quarantine_flag" [id="node_p5_micro_quarantine_flag", label="N35\nAgent quarantine state\nindicator", style="rounded,filled", fillcolor="white"];
}
subgraph cluster_meso {
