"p5_meso_layer_index_contact_load" [id="node_p5_meso_layer_index_contact_load", label="N37\nPer-index contact load\nwithin a layer", style="rounded,filled", fillcolor="white"];
"p5_meso_layer_load_dispersion" [id="node_p5_meso_layer_load_dispersion", label="N38\nCross-layer dispersion of\ncontact load", style="rounded,filled", fillcolor="white"];
}
subgraph cluster_macro {
rank=same;
label="Macro"; color="#dddddd"; margin=10; fontsize=16;
"p5_macro_traced_per_diagnosis" [id="node_p5_macro_traced_per_diagnosis", label="N39\nKnown-contact transitions\nper new diagnosis", style="rounded,filled", fillcolor="white"];
"p5_macro_mean_tracing_latency" [id="node_p5_macro_mean_tracing_latency", label="N40\nMean per-agent tracing\nlatency at quarantine start", style="rounded,filled", fillcolor="white"];
"p5_macro_quarantine_coverage" [id="node_p5_macro_quarantine_coverage", label="N41\nQuarantine coverage of\nobserved agent-steps", style="rounded,filled", fillcolor="white"];
"p5_macro_known_contact_prevalence" [id="node_p5_macro_known_contact_prevalence", label="N42\nKnown-contact prevalence\nshare", style="rounded,filled", fillcolor="white"];
}
