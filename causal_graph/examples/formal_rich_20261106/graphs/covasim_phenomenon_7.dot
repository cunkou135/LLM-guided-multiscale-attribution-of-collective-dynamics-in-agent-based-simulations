"p7_meso_layer_exposure_share" [id="node_p7_meso_layer_exposure_share", label="N54\nLayer share of attributed\nnew exposure transitions", style="rounded,filled", fillcolor="white"];
"p7_meso_band_share_drift" [id="node_p7_meso_band_share_drift", label="N55\nAge-band exposure share\ndrift from first active step", style="rounded,filled", fillcolor="white"];
}
subgraph cluster_macro {
rank=same;
label="Macro"; color="#dddddd"; margin=10; fontsize=16;
