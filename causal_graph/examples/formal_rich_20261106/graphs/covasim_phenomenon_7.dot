"p7_macro_median_age_of_new_exposures" [id="node_p7_macro_median_age_of_new_exposures", label="N59\nMedian age of agents with\nnew exposure transitions", style="rounded,filled", fillcolor="white"];
}
"p7_micro_exposure_step_index" -> "p7_macro_age_composition_drift" [id="edge_upward__b01_r0037", color="#27667b", style="solid", constraint=true];
